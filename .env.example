# --- General n8n Configuration ---
TZ=America/New_York # Set your timezone (e.g., America/New_York, Europe/Lisbon)
N8N_BLOCK_ENV_ACCESS_IN_NODE=true # It is recommended to set this to 'true' in production for security.
                                  # If false, nodes can access all environment variables.

# --- PostgreSQL Database Credentials ---
POSTGRES_HOST=localhost       # Hostname for the PostgreSQL database
POSTGRES_PORT=5432            # Port for the PostgreSQL database
POSTGRES_USER=your_postgres_user # Username for the PostgreSQL database
POSTGRES_PASSWORD=your_postgres_password # Password for the PostgreSQL database
POSTGRES_DB=your_database_name # Database name to connect to
DB_SCHEMA_CORE=invest_core    # [Optional] The PostgreSQL schema name for core investment data.
                              # Defaults to 'invest_core' if not set in n8n expressions.
DB_SCHEMA_AUDIT=invest_audit  # [Optional] The PostgreSQL schema name for audit/logging data.
                              # Defaults to 'invest_audit' if not set in n8n expressions.

# --- Telegram Bot Configuration ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token # Your Telegram bot token (from BotFather)
TELEGRAM_CHAT_ID=your_telegram_chat_id # The chat ID where the bot should send messages

# --- OpenAI API Configuration ---
OPENAI_API_KEY=your_openai_api_key # Your OpenAI API Key

# --- OpenAI Models Configuration ---
# Define the specific OpenAI models to use for different tasks.
# Refer to OpenAI documentation for available models.
OPEN_AI_CHEAP_MODEL=gpt-4o-mini     # Used for normal priority analysis (cost-optimized)
OPEN_AI_EXPENSIVE_MODEL=gpt-4o      # Used for high priority analysis (higher quality/capability)
OPEN_AI_SUMMARY_MODEL=gpt-4o-mini    # Used for initial email summarization and triage (speed/cost-optimized)

# --- Gmail Configuration ---
GMAIL_LABEL_ID=Label_5757564878679789 # The Gmail label ID for filtering unread investment messages.
                                        # Find this by inspecting the label's URL in Gmail.

# --- Market Data (uses existing invest_core.price table) ---
MARKET_DATA_ENABLED=true
PRICE_STALENESS_HOURS=24  # Alert if prices older than this

# --- Immediate Alert Settings (v2) ---
# Controls when the Collector workflow sends immediate Telegram alerts
IMMEDIATE_ALERT_URGENCY_THRESHOLD=80  # Send alert if urgency score exceeds this (0-100)
IMMEDIATE_ALERT_WATCHLIST=            # Comma-separated symbols that always trigger alerts: NVDA,TSLA

# --- Weekly Digest Settings (v2) ---
# Controls the Weekly Digest workflow schedule
WEEKLY_DIGEST_ENABLED=true
WEEKLY_DIGEST_CRON=0 9 * * 6          # Cron expression: Saturday 9am
WEEKLY_DIGEST_TIMEZONE=Europe/Lisbon  # Timezone for the schedule
WEEKLY_DIGEST_MODEL=gpt-4o            # Model for weekly synthesis (recommend gpt-4o for quality)